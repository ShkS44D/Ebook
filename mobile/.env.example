DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
API_PORT=3001
EXPO_PUBLIC_API_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
# Optional email delivery for password resets
# SMTP_URL=smtps://USER:PASSWORD@HOST:465
# MAIL_FROM=iBook <support@example.com>
# NODE_ENV=production
# Persistent local volume for uploaded reels (default: ./media)
# MEDIA_DIR=/var/lib/ibook/media
# Comma-separated account UUIDs allowed to review and hide reported reels
# REEL_MODERATOR_IDS=
# Public web origin for share links from native devices
# EXPO_PUBLIC_WEB_URL=https://your-ibook-site.example
