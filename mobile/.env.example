DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
API_PORT=3001
EXPO_PUBLIC_API_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
# Optional email delivery for password resets
# SMTP_URL=smtps://USER:PASSWORD@HOST:465
# MAIL_FROM=iBook <support@example.com>
# NODE_ENV=production
# Persistent local volume for uploaded reels (default: ./media)
# MEDIA_DIR=/var/lib/ibook/media
# Cloudinary direct uploads for reel video. Keep API_SECRET server-only.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Comma-separated account UUIDs allowed to review and hide reported reels
# REEL_MODERATOR_IDS=
# Public web origin for share links from native devices
# EXPO_PUBLIC_WEB_URL=https://your-ibook-site.example

# Book imports: assign trusted account UUIDs to the review screen.
# BOOK_ADMIN_IDS=
# Local durable source and asset directory (ignored by Git).
# BOOK_STORAGE_DIR=/var/lib/ibook/books
# Production requires a PRIVATE Vercel Blob store, shared by web API and worker.
# BOOK_BLOB_READ_WRITE_TOKEN=
# Optional dedicated Gutendex instance; public service is used by default.
# GUTENDEX_URL=https://your-catalogue.example
# GOOGLE_BOOKS_API_KEY=
# Explicit additional HTTPS hosts for authorized provider file downloads.
# BOOK_DOWNLOAD_HOSTS=
# Optional OCRmyPDF executable on the worker; requires OCRmyPDF/Tesseract installation.
# BOOK_OCR_EXECUTABLE=/usr/local/bin/ocrmypdf
